# Copy to .env and fill in. .env is git-ignored. Never commit real keys.

# Shared secret between flins-core and the WhatsApp sidecar. Any long random string:
#   python -c "import secrets; print(secrets.token_hex(32))"
FLINS_WA_SECRET=

# AI providers. Set the ones you want; config/flins.yaml says which job uses which.
# A provider without a key is simply skipped.
ANTHROPIC_API_KEY=     # console.anthropic.com (separate from a Claude Pro subscription)
GEMINI_API_KEY=        # aistudio.google.com -> Get API key
GROQ_API_KEY=          # console.groq.com -> API Keys
NVIDIA_API_KEY=        # build.nvidia.com -> Get API Key (starts with nvapi-)
OPENAI_API_KEY=
OPENROUTER_API_KEY=
# Ollama (local) needs no key: install it, `ollama pull <model>`, and list it in flins.yaml.

# Encrypted backups (M9): at least 12 characters, e.g. four random words. Keep a copy in your
# password manager: without it a backup cannot be opened.
FLINS_BACKUP_PASSPHRASE=
